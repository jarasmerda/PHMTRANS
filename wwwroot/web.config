<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="PublicHome" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="landing.html" />
        </rule>
        <rule name="PublicIndex" stopProcessing="true">
          <match url="^index\.html$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="landing.html" />
        </rule>
        <rule name="ErpHome" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="(^|\.)erp\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="erp.html" />
        </rule>
        <rule name="ErpApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="(^|\.)erp\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8089/api/{R:1}" />
        </rule>
        <rule name="DispHome" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="(^|\.)disp\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="dispecink.html" />
        </rule>
        <rule name="DispApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="(^|\.)disp\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8089/api/{R:1}" />
        </rule>
        <rule name="CrmHome" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="(^|\.)crm\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="crm.html" />
        </rule>
        <rule name="CrmApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="(^|\.)crm\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8089/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
