<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ErpHome" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="(^|\.)erp\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="erp.html" />
        </rule>
        <rule name="ErpApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="(^|\.)erp\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8089/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
