<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="WwwToApex" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^www\.phmtrans\.cz(?::\d+)?$" />
            <add input="{REQUEST_URI}" pattern="^/health$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://phmtrans.cz/{R:0}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="PublicHome" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="landing.html" />
        </rule>
        <rule name="PublicIndex" stopProcessing="true">
          <match url="^index\.html$" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="landing.html" />
        </rule>
        <rule name="LegacyErp" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^(www\.)?erp\.phmtrans\.cz(?::\d+)?$" />
            <add input="{REQUEST_URI}" pattern="^/health$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://intranet.phmtrans.cz/ERP/{R:0}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="LegacyDisp" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^(www\.)?disp\.phmtrans\.cz(?::\d+)?$" />
            <add input="{REQUEST_URI}" pattern="^/health$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://intranet.phmtrans.cz/Dispecink/{R:0}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="LegacyCrm" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{HTTP_HOST}" pattern="^(www\.)?crm\.phmtrans\.cz(?::\d+)?$" />
            <add input="{REQUEST_URI}" pattern="^/health$" negate="true" />
          </conditions>
          <action type="Redirect" url="https://intranet.phmtrans.cz/CRM/{R:0}" appendQueryString="true" redirectType="Permanent" />
        </rule>
        <rule name="ErpHome" stopProcessing="true">
          <match url="^ERP/?$" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?intranet\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="erp.html" />
        </rule>
        <rule name="ErpApi" stopProcessing="true">
          <match url="^ERP/api/(.*)" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?intranet\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8089/api/{R:1}" />
        </rule>
        <rule name="ErpAsset" stopProcessing="true">
          <match url="^ERP/(.+)" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?intranet\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="{R:1}" />
        </rule>
        <rule name="DispHome" stopProcessing="true">
          <match url="^Dispecink/?$" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?intranet\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="dispecink.html" />
        </rule>
        <rule name="DispApi" stopProcessing="true">
          <match url="^Dispecink/api/(.*)" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?intranet\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8089/api/{R:1}" />
        </rule>
        <rule name="DispAsset" stopProcessing="true">
          <match url="^Dispecink/(.+)" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?intranet\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="{R:1}" />
        </rule>
        <rule name="CrmHome" stopProcessing="true">
          <match url="^CRM/?$" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?intranet\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="crm.html" />
        </rule>
        <rule name="CrmApi" stopProcessing="true">
          <match url="^CRM/api/(.*)" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?intranet\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8089/api/{R:1}" />
        </rule>
        <rule name="CrmAsset" stopProcessing="true">
          <match url="^CRM/(.+)" ignoreCase="true" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?intranet\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="{R:1}" />
        </rule>
        <rule name="IntranetApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^(www\.)?intranet\.phmtrans\.cz(?::\d+)?$" />
          </conditions>
          <action type="Rewrite" url="http://127.0.0.1:8089/api/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
